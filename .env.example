DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 正式部署且前面已經有反向代理做 TLS termination 時才設為 True，見 README「正式部署前檢查清單」
DJANGO_USE_HTTPS=False
POSTGRES_DB=apcs_db
POSTGRES_USER=apcs_user
POSTGRES_PASSWORD=apcs_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=adminpassword

# Google OAuth 2.0（至 Google Cloud Console 申請）
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# Email（忘記密碼等系統信件）
# 開發環境留空即可：預設用 console backend，信件內容會印在 web 容器 log。
# 正式環境要真的寄出信件，取消註解並填寫下方 SMTP 設定：
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=APCS 練習平台 <your-email@gmail.com>
